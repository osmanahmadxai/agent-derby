{
  "name": "agent-derby",
  "version": "0.1.1",
  "description": "Race AI coding agents (Claude Code, Codex CLI, Gemini CLI, or any other) on the same task, watch them live side by side, and try what each one built.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-derby": "dist/cli.js"
  },
  "main": "dist/desktop.js",
  "files": [
    "dist/cli.js",
    "dist/mock-agent.js",
    "dist/web",
    "config",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --server-only && node dist/cli.js --no-open --dev & vite --config web/vite.config.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "desktop": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "prepublishOnly": "node scripts/build.mjs",
    "dist:dir": "node scripts/build.mjs && electron-builder --dir --publish never"
  },
  "keywords": [
    "ai",
    "coding-agent",
    "claude-code",
    "codex",
    "gemini-cli",
    "benchmark",
    "race"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "npm": "^12.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "author": "Agent Derby contributors",
  "build": {
    "appId": "dev.agent-derby.app",
    "productName": "Agent Derby",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "config/**",
      "package.json",
      "LICENSE",
      "node_modules/ws/**",
      "node_modules/node-pty/**",
      "node_modules/npm/**",
      "!node_modules/npm/{docs,man}/**",
      "!node_modules/node-pty/{src,deps,third_party,scripts}/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Agent Derby contributors <185453132+osmanahmadxai@users.noreply.github.com>"
    }
  },
  "homepage": "https://github.com/osmanahmadxai/agent-derby",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osmanahmadxai/agent-derby.git"
  },
  "bugs": {
    "url": "https://github.com/osmanahmadxai/agent-derby/issues"
  }
}
